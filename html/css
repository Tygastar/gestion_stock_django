<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#eef1f4;--panel:#fff;--ink:#16212e;--muted:#5c6b7a;--line:#d5dce3;--accent:#1f4e79;--on:#fff;--warn:#f2b600;--warnbg:#fff4cc;--danger:#c0392b;--ok:#2e7d4f;
--font:"Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",sans-serif}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10161d;--panel:#192330;--ink:#e8edf2;--muted:#93a1b0;--line:#2a3847;--accent:#5fa3dd;--on:#0b1520;--warnbg:#3a3010;--danger:#ef7a6c;--ok:#6cc58f}}
:root[data-theme="dark"]{--bg:#10161d;--panel:#192330;--ink:#e8edf2;--muted:#93a1b0;--line:#2a3847;--accent:#5fa3dd;--on:#0b1520;--warnbg:#3a3010;--danger:#ef7a6c;--ok:#6cc58f}
*,*::before,*::after{box-sizing:inherit}
